# ==========================================
# Holy Kids Email & Admin Configuration
# ==========================================

# Designated Admin Details
ADMIN_EMAIL=theholykidspublication@gmail.com
ADMIN_NAME="Holy Kids Publication"

# Option 1: Gmail SMTP (Recommended for theholykidspublication@gmail.com)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=theholykidspublication@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Option 2: Resend API (Alternative)
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM="Holy Kids" <onboarding@resend.dev>

# Option 3: Custom SMTP Server
# SMTP_HOST=smtp.yourserver.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Holy Kids Publication" <info@theholykids.com>

# ==========================================
# Anti-Bot & Spam Protection (Google reCAPTCHA v3)
# ==========================================
# Create a v3 key pair at: https://www.google.com/recaptcha/admin
# (Leave as dummy or empty during local testing; Honeypot & Rate Limiting run automatically)
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY_HERE
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_V3_SECRET_KEY_HERE
